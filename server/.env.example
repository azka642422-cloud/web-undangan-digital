NODE_ENV=development
PORT=8787
APP_ORIGIN=http://localhost:5173
# Development/direct connection only. In production, configure this to the exact trusted proxy topology of the hosting platform.
# Never increase this value merely to make X-Forwarded-For work; a wrong value can let clients spoof the IP used by rate limiting.
TRUST_PROXY_HOPS=0
# Production note: express-rate-limit's default in-memory store is per-process only.
# Before scaling the API to multiple replicas/instances, configure a shared external rate-limit store (for example Redis)
# or enforce equivalent limits at the trusted edge/gateway. Do not treat the in-memory limiter as distributed protection.
DATABASE_URL=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
