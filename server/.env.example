NODE_ENV=development
PORT=8787
APP_ORIGIN=http://localhost:5173
# Default 0 means forwarded client-IP headers are NOT trusted.
# In production set this only to the exact number of reverse-proxy hops controlled by your deployment (currently supported: 0, 1, or 2).
# Never increase this merely to make X-Forwarded-For work: an incorrect value can allow client-IP spoofing and weaken rate limits.
TRUST_PROXY_HOPS=0
# PostgreSQL is required for production. Sensitive mutation rate limits use atomic shared PostgreSQL buckets,
# so limits remain consistent across multiple API replicas. If this database is unavailable, protected mutations fail closed with 503.
DATABASE_URL=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
# Private S3-compatible media storage. Keep the bucket non-public; uploads enter the quarantine/ prefix.
# Production endpoints must use HTTPS. Credentials must be server-only and least privilege.
MEDIA_STORAGE_ENDPOINT=
MEDIA_STORAGE_REGION=auto
MEDIA_STORAGE_BUCKET=
MEDIA_STORAGE_ACCESS_KEY=
MEDIA_STORAGE_SECRET_KEY=
MEDIA_STORAGE_FORCE_PATH_STYLE=false
